# cloudAdminCommands.azcli

#------------------------------------AZURE CLI Environment Setup-----------------------------------------------

# List Azure environments
az cloud list --output table
# Set Azure environment (example: AzureCloud)
az cloud set --name AzureCloud
# Log in to Azure
az login
# List available locations
az account list-locations --output table

#------------------------------------AZURE ACCOUNT COMMANDS-----------------------------------------------

# List subscriptions (name and ID)
az account list --query "[].{Name:name, Id:id}" --output table
# Get specific subscription (example: Agency Production - Azure Commercial)
az account list --query "[?name=='Agency Production - Azure Commercial'].{Name:name, Id:id}" --output json
# Set subscription
az account set --subscription "SUBSCRIPTION_ID"
# Show current subscription context
az account show
# List resource groups
az group list --output table

#------------------------------------AZURE RG COMMANDS-----------------------------------------------

# Get resource group ID
az group show --name "rgName" --query id --output tsv
# List role assignments for a resource group
az role assignment list --resource-group "resourceGroup" --output table
# Delete resource group
az group delete --name MyResourceGroup --yes
# List deployments in a resource group
az deployment group list --resource-group "zus1-agency-application-v010-sbx-budget-rg" --output table
# Get activity log for a resource group
az monitor activity-log list --resource-group "zus1-agency-application-v010-sbx-budget-rg" --output table
# List role definitions containing SQL
az role definition list --query "[?contains(name, 'SQL')]" --output table

#------------------------------------AZURE STORAGE ACCOUNT COMMANDS-----------------------------------------------

# Get storage account ID
az storage account show --name saName --resource-group rgName --query id --output tsv
# List file shares in a storage account
az storage share list --account-name saName --output table
# List local users for a storage account
az storage account local-user list --account-name saName --resource-group rgName --output table
# WORM Policy (immutability)
az storage container immutability-policy create --account-name zus1agencynisttestsbxv1sa --container zus1agencynisttestsbxv1cr --period 2555 --resource-group zus1-agency-nisttest-sbx-v1-rg
# Lock immutability policy
az storage container immutability-policy lock --account-name zus1agencynisttestsbxv1sa --container zus1agencynisttestsbxv1cr --etag <etag> --resource-group zus1-agency-nisttest-sbx-v1-rg
# Get immutability policy
az storage container immutability-policy show --account-name zus1agencynisttestsbxv1sa --container zus1agencynisttestsbxv1cr --resource-group zus1-agency-nisttest-sbx-v1-rg

#------------------------------------AZURE ACTIVE DIRECTORY COMMANDS----------------------------------------------

# List app registrations
az ad app list --display-name "<App Registration Name>" --output table
# Get user object ID
az ad user show --id "user@website.com" --query objectId --output tsv
# Get group object ID
az ad group show --group "UserGroup" --query objectId --output tsv
# Get role definition by name
az role definition list --name "Key Vault Secrets User" --query "[0].{Name:name, Id:id}" --output table
# Get role definition details
az role definition show --name "RoleName" --output json
# Assign role to Entra object
az role assignment create --assignee "AssigneeObject/Application/UserID" --role "RoleDefinition" --scope "ScopeDefinition"
# List role assignments for an object
az role assignment list --assignee "AssigneeObject/Application/UserID" --output table
# List groups starting with Agency
az ad group list --query "[?starts_with(displayName, 'Agency')].{DisplayName:displayName, Id:objectId}" --output table
# List groups containing Agency (requires Microsoft Graph CLI)
# az graph query -q "..." (not directly supported in azcli)

#------------------------------------AZURE CONTAINER REGISTRY REPOSITORY COMMANDS----------------------------------------------

# Note: ACR token management requires Azure CLI or REST API calls
# Use az acr token commands or REST API as needed

#---------------------------------------------------AZURE APP SERVICE COMMANDS---------------------------------------------------

# Add CORS origin to web app
az webapp cors add --resource-group DWDAPI --name dwdapi --allowed-origins https://examplewebsite.com


#----------------------------------------------------------AZURE DNS--------------------------------------------------------------------------------

# List DNS zones
az network dns zone list --output table
# Show DNS zone details
az network dns zone show --name "example.com" --output table
# Create DNS zone
az network dns zone create --name "example.com" --resource-group "MyResourceGroup" --output table
# Delete DNS zone
az network dns zone delete --name "example.com" --resource-group "MyResourceGroup" --yes --output table
# List DNS records
az network dns record-set list --zone-name "example.com" --output table
# Show DNS record details
az network dns record-set show --name "www" --type "A" --zone-name "example.com" --output table
# Create DNS record
az network dns record-set a add-record --zone-name "example.com" --record-set-name "www" --ipv4-address "1.2.3.4" --output table
# Delete DNS record
az network dns record-set a remove-record --zone-name "example.com" --record-set-name "www" --ipv4-address "1.2.3.4" --output table
# AFD Custom Domain Validation Token
az afd custom-domain show -g <resourceGroup> --profile-name '<profileName>' -n <customDomainResourceName> --query validationProperties.validationToken -o tsv
#----------------------------------------------------------AZURE FRONT DOOR (AFD) CUSTOM DOMAIN COMMANDS----------------------------------------------------------

# Variables (override as needed)
$rg="zus1-rc-rcwebsite-dev-v1-rg"
$profile="zus1rcrcwebsitedevv1fd"
$apexDomainResource="rebelcorpo-com"          # Resource name in AFD (dots replaced with dashes)
$wwwDomainResource="www-rebelcorpo-com"       # Resource name for www host

# Show full custom domain object (apex)
az afd custom-domain show -g $rg --profile-name $profile -n $apexDomainResource

# Show full custom domain object (www)
az afd custom-domain show -g $rg --profile-name $profile -n $wwwDomainResource

# Show current validation tokens (apex & www)
az afd custom-domain show -g $rg --profile-name $profile -n $apexDomainResource --query validationProperties.validationToken -o tsv
az afd custom-domain show -g $rg --profile-name $profile -n $wwwDomainResource  --query validationProperties.validationToken -o tsv

# Show validation & certificate status (key fields)
az afd custom-domain show -g $rg --profile-name $profile -n $apexDomainResource --query "{name:name,validationState:validationProperties.validationState,provisioningState:provisioningState,certType:tlsSettings.certificateType,certStatus:tlsSettings.certificateStatus,hostName:hostName}" -o json
az afd custom-domain show -g $rg --profile-name $profile -n $wwwDomainResource  --query "{name:name,validationState:validationProperties.validationState,provisioningState:provisioningState,certType:tlsSettings.certificateType,certStatus:tlsSettings.certificateStatus,hostName:hostName}" -o json

# Regenerate validation token (ONLY if you need to rotate token and update TXT record)
az afd custom-domain regenerate-validation-token -g $rg --profile-name $profile --custom-domain-name $apexDomainResource --query validationProperties.validationToken -o tsv
az afd custom-domain regenerate-validation-token -g $rg --profile-name $profile --custom-domain-name $wwwDomainResource  --query validationProperties.validationToken -o tsv

# After regeneration remember to update corresponding _dnsauth TXT records, then wait (5-15m typical) and re-check validationState.

# (Optional) Compact table view for quick status scan
az afd custom-domain list -g $rg --profile-name $profile --query "[].{name:name,host:hostName,validation:validationProperties.validationState,prov:provisioningState,certType:tlsSettings.certificateType,certStatus:tlsSettings.certificateStatus}" -o table

# (Optional) PowerShell polling loop (stop with Ctrl+C)
<#
while ($true) {
	az afd custom-domain list -g $rg --profile-name $profile --query "[].{name:name,validation:validationProperties.validationState,certStatus:tlsSettings.certificateStatus}" -o table
	Start-Sleep -Seconds 30
}
#>

az afd custom-domain show -g zus1-rc-rcwebsite-dev-v1-rg --profile-name zus1rcrcwebsitedevv1fd -n rebelcorpo-com --query "{validation:validationProperties.validationState,prov:provisioningState,certType:tlsSettings.certificateType,certStatus:tlsSettings.certificateStatus}" -o json
az afd custom-domain show -g zus1-rc-rcwebsite-dev-v1-rg --profile-name zus1rcrcwebsitedevv1fd -n www-rebelcorpo-com --query "{validation:validationProperties.validationState,prov:provisioningState,certType:tlsSettings.certificateType,certStatus:tlsSettings.certificateStatus}" -o json
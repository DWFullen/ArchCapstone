@page "/Shop"

<PageTitle>Shop</PageTitle>

@inject IBTCPayService BTCPay
@inject NavigationManager NavigationManager
@using MyBlazorApp.Models
@using MyBlazorApp.Services
@implements IDisposable

<h1>Shop</h1>

<p>Select an item and pay securely with Bitcoin via BTCPay Server.</p>

<div class="shop-items">
    <div class="shop-card">
        <h4>Rebel Merch</h4>
        <p class="price">$12.34</p>
        <button class="btn btn-primary" @onclick='() => StartCheckout(12.34m, "USD", "ORD-123")' disabled="@isBusy">
            @if (isBusy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Processing…</span>
            }
            else
            {
                <span>Pay with Bitcoin</span>
            }
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
}

@if (showModal && !string.IsNullOrWhiteSpace(invoiceUrl))
{
    <div class="btcpay-modal-backdrop" @onclick="Close" role="presentation">
        <div class="btcpay-modal" @onclick:stopPropagation role="dialog" aria-modal="true" tabindex="-1">
            <button class="close" @onclick="Close" aria-label="Close payment dialog">×</button>
            <iframe src="@invoiceUrl" title="BTCPay checkout" class="btcpay-iframe"></iframe>
        </div>
    </div>
}

@if (paymentStatus is not null)
{
    <div class="alert @(paymentStatus.IsPaid ? "alert-success" : paymentStatus.IsExpiredOrInvalid ? "alert-warning" : "alert-info") mt-3" role="alert">
        @if (paymentStatus.IsPaid)
        {
            <strong>Payment received!</strong>
            <span> Thank you – your order is confirmed.</span>
        }
        else if (paymentStatus.IsExpiredOrInvalid)
        {
            <strong>Invoice @paymentStatus.Status.</strong>
            <span> Please try again.</span>
        }
        else
        {
            <strong>Invoice status: @paymentStatus.Status</strong>
            @if (!string.IsNullOrEmpty(paymentStatus.AdditionalStatus))
            {
                <span> (@paymentStatus.AdditionalStatus)</span>
            }
        }
    </div>
}

@code {
    bool isBusy = false;
    bool showModal = false;
    string? invoiceUrl = null;
    string? currentInvoiceId = null;
    string? errorMessage = null;
    InvoiceStatusResult? paymentStatus = null;
    System.Threading.Timer? _pollTimer;

    async Task StartCheckout(decimal amount, string currency, string orderId)
    {
        isBusy = true;
        errorMessage = null;
        paymentStatus = null;
        StateHasChanged();

        try
        {
            var result = await BTCPay.CreateInvoiceAsync(amount, currency, orderId, NavigationManager.Uri);

            if (result is null || string.IsNullOrWhiteSpace(result.CheckoutUrl))
            {
                errorMessage = "Could not create a payment invoice. Please try again.";
                return;
            }

            invoiceUrl = result.CheckoutUrl;
            currentInvoiceId = result.InvoiceId;
            showModal = true;

            // Poll for payment status every 5 seconds while the modal is open
            _pollTimer?.Dispose();
            _pollTimer = new System.Threading.Timer(_ => InvokeAsync(PollStatusAsync), null,
                TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
        catch (Exception ex)
        {
            errorMessage = $"Payment error: {ex.Message}";
        }
        finally
        {
            isBusy = false;
            StateHasChanged();
        }
    }

    async Task PollStatusAsync()
    {
        if (currentInvoiceId is null) return;

        try
        {
            var status = await BTCPay.GetInvoiceStatusAsync(currentInvoiceId);
            if (status is null) return;

            paymentStatus = status;

            if (status.IsPaid || status.IsExpiredOrInvalid)
            {
                _pollTimer?.Dispose();
                _pollTimer = null;
                showModal = false;
            }

            StateHasChanged();
        }
        catch
        {
            // silently ignore transient poll errors
        }
    }

    void Close()
    {
        _pollTimer?.Dispose();
        _pollTimer = null;
        showModal = false;
        invoiceUrl = null;
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }
}


@page "/Shop"

<PageTitle>Shop</PageTitle>

@inject HttpClient Http
@inject NavigationManager NavigationManager


<h1>Hello, shop!</h1>

<!-- Load the btcpay.js script from your BTCPay instance -->
<script src="https://btcpay263134.lndyn.com/modal/btcpay.js"></script>

<button class="btn btn-primary" @onclick="StartCheckout">Pay with BTCPay</button>

@if (showModal)
{
  <div class="btcpay-modal-backdrop" @onclick="Close" role="presentation">
    <div class="btcpay-modal" @onclick:stopPropagation role="dialog" aria-modal="true" tabindex="-1">
      <button class="close" @onclick="Close" aria-label="Close payment dialog">×</button>
      <iframe src="@invoiceUrl" title="BTCPay checkout" class="btcpay-iframe"></iframe>
    </div>
  </div>
}

@code {
  bool showModal = false;
  string invoiceUrl;

  async Task StartCheckout()
  {
    var req = new { Amount = 12.34m, Currency = "USD", OrderId = "ORD-123", ReturnUrl = NavigationManager.Uri };
    var resp = await Http.PostAsJsonAsync("/api/payments/create-invoice", req);
    if (resp.IsSuccessStatusCode)
    {
      var obj = await resp.Content.ReadFromJsonAsync<JsonElement>();
      invoiceUrl = obj.GetProperty("checkoutUrl").GetString();
      showModal = true;
      StateHasChanged();
    }
    else
    {
      // handle error
    }
  }

  void Close()
  {
    showModal = false;
    invoiceUrl = null;
  }
}

Welcome to your new app.


@page "/Shop"

<PageTitle>Shop</PageTitle>

@inject HttpClient Http
@inject NavigationManager NavigationManager
@using System.Text.Json
@using System.Net.Http.Json


<h1>Hello, shop!</h1>

<!-- Load the btcpay.js script from your BTCPay instance -->
<script src="https://btcpay263134.lndyn.com/modal/btcpay.js"></script>

<button class="btn btn-primary" @onclick="StartCheckout">Pay with BTCPay</button>

@if (showModal)
{
  <div class="btcpay-modal-backdrop" @onclick="Close" role="presentation">
    <div class="btcpay-modal" @onclick:stopPropagation role="dialog" aria-modal="true" tabindex="-1">
      <button class="close" @onclick="Close" aria-label="Close payment dialog">×</button>
      <iframe src="@invoiceUrl" title="BTCPay checkout" class="btcpay-iframe"></iframe>
    </div>
  </div>
}

@code {
  bool showModal = false;
  string? invoiceUrl = null;

  async Task StartCheckout()
  {
    var req = new { Amount = 12.34m, Currency = "USD", OrderId = "ORD-123", ReturnUrl = NavigationManager.Uri };
    var resp = await Http.PostAsJsonAsync("/api/payments/create-invoice", req);
    if (resp.IsSuccessStatusCode)
    {
      var body = await resp.Content.ReadAsStringAsync();
      try
      {
        using var doc = JsonDocument.Parse(body);
        var root = doc.RootElement;
        if (root.TryGetProperty("checkoutUrl", out var cu)) invoiceUrl = cu.GetString();
        else if (root.TryGetProperty("data", out var data) && data.TryGetProperty("checkoutLink", out var cl)) invoiceUrl = cl.GetString();
        else if (root.TryGetProperty("data", out data) && data.TryGetProperty("url", out var u)) invoiceUrl = u.GetString();
      }
      catch
      {
        // ignore parse errors - handle as generic failure below
        invoiceUrl = null;
      }

      if (!string.IsNullOrWhiteSpace(invoiceUrl))
      {
        showModal = true;
        StateHasChanged();
      }
    }
    else
    {
      // handle error
    }
  }

  void Close()
  {
    showModal = false;
    invoiceUrl = null;
  }
}

Welcome to your new app.

